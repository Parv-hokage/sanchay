{
  "name": "@sanchay/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "prisma generate --schema=../../prisma/schema.prisma && nest build && node scripts/bundle-serverless.js",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "echo 'Linting API'",
    "test": "vitest run"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^6.4.0",
    "@sanchay/config": "workspace:*",
    "@sanchay/shared": "workspace:*",
    "@sanchay/types": "workspace:*",
    "@sanchay/validation": "workspace:*",
    "@sanchay/worker-document-processing": "workspace:*",
    "@sanchay/worker-knowledge-ingestion": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "helmet": "^8.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.1",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
