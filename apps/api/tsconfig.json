{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": false,
    "declarationMap": false,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@sanchay/types": ["../../packages/types/src/index.ts"],
      "@sanchay/validation": ["../../packages/validation/src/index.ts"],
      "@sanchay/shared": ["../../packages/shared/src/index.ts"],
      "@sanchay/config": ["../../packages/config/src/index.ts"],
      "@sanchay/worker-document-processing": ["../../workers/document-processing/src/index.ts"],
      "@sanchay/worker-knowledge-ingestion": ["../../workers/knowledge-ingestion/src/index.ts"]
    },
    "incremental": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
