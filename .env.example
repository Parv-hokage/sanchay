# ==============================================================================
# SANCHAY ENVIRONMENT CONFIGURATION TEMPLATE
# Do NOT place production secrets or private keys in this file.
# Copy this file to .env for local development.
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
WEB_PORT=3000

# Client and CORS
SANCHAY_WEB_URL=http://localhost:3000
SANCHAY_API_URL=http://localhost:4000/api/v1
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL + pgvector)
DATABASE_URL=postgresql://sanchay_user:sanchay_password@localhost:5432/sanchay_db?schema=public

# Redis & Queue
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Session & JWT
JWT_SECRET=super_secret_jwt_key_at_least_32_chars_long_for_dev_only
SESSION_SECRET=super_secret_session_key_for_dev_only

# Storage (S3 / MinIO compatible)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_BUCKET=sanchay-documents
OBJECT_STORAGE_ACCESS_KEY=minioadmin
OBJECT_STORAGE_SECRET_KEY=minioadmin
OBJECT_STORAGE_USE_SSL=false

# AI & Embedding Providers (Interface Abstraction)
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

EMBEDDING_PROVIDER=mock
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=text-embedding-3-small

# Observability
LOG_LEVEL=debug
OTEL_EXPORTER_OTLP_ENDPOINT=
